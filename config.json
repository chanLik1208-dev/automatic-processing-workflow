{
  "providers": {
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "default_model": "deepseek-chat"
    },
    "lmstudio": {
      "base_url": "http://localhost:1234/v1",
      "api_key": "lm-studio",
      "default_model": "qwen3.5-9b-uncensored-hauhaucs-aggressive-mlx"
    }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "tick_seconds": 30,
  "readable_paths": [
    "~/*.log",
    "~/Dynamization-src/**",
    "~/ai-workflow/reports/*"
  ]
}